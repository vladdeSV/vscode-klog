{
    "name": "vscode-klog",
    "displayName": "klog",
    "description": "klog syntax and validation",
    "version": "1.4.0",
    "license": "MIT",
    "publisher": "vladdeSV",
    "icon": "resource/klog-icon.png",
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "build": "bun run build:client && bun run build:server",
        "build:client": "bun build client/src/extension.ts --outdir client/out --target node --format cjs --external vscode --sourcemap=linked",
        "build:server": "bun build server/src/server.ts --outdir server/out --target node --format cjs --sourcemap=linked",
        "typecheck": "tsc --noEmit --project client && tsc --noEmit --project server",
        "lint": "bun run --filter vscode-klog-server lint",
        "package": "bun run build && vsce package --no-dependencies --githubBranch=main",
        "publish": "bun run build && vsce publish --no-dependencies --githubBranch=main"
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "author": {
        "name": "Vladimirs Nordholm",
        "email": "v@vladde.net",
        "url": "https://vladde.net/"
    },
    "bugs": {
        "url": "https://github.com/vladdeSV/vscode-klog/issues",
        "email": "v@vladde.net"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vladdeSV/vscode-klog.git"
    },
    "contributes": {
        "languages": [
            {
                "id": "klog",
                "aliases": [
                    "klog"
                ],
                "extensions": [
                    ".klg"
                ]
            }
        ],
        "grammars": [
            {
                "language": "klog",
                "scopeName": "source.klog",
                "path": "./syntaxes/klog.json"
            }
        ],
        "snippets": [
            {
                "language": "klog",
                "scopeName": "source.klog",
                "path": "./snippets/klog.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "klog",
            "properties": {
                "klog.languageServer.enable": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable communication with klog executable to validate documents."
                },
                "klog.languageServer.path": {
                    "type": "string",
                    "markdownDescription": "%ext.config.klogPath%",
                    "scope": "resource",
                    "description": "Path to executable.",
                    "default": "klog"
                },
                "klog.languageServer.validateOn": {
                    "type": "string",
                    "default": "save",
                    "enum": [
                        "save",
                        "edit"
                    ],
                    "enumDescriptions": [
                        "Validate after saving document",
                        "Validate while typing"
                    ],
                    "description": "When document should be validated."
                }
            }
        }
    },
    "main": "./client/out/extension",
    "activationEvents": [
        "onLanguage:klog"
    ],
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@vscode/vsce": "^4.0.0",
        "typescript": "^6.0.3"
    }
}
